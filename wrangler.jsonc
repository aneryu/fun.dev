{
  "$schema": "./node_modules/wrangler/config-schema.json",
  "name": "fundev",
  "pages_build_output_dir": "./dist",
  "compatibility_date": "2026-10-13",
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "fun-dev-progress-local",
      "database_id": "00000000-0000-0000-0000-000000000000",
      "migrations_dir": "./migrations"
    },
    {
      "binding": "MODELS_DB",
      "database_name": "fundev-models-local",
      "database_id": "00000000-0000-0000-0000-000000000000",
      "migrations_dir": "./migrations-models"
    }
  ],
  "r2_buckets": [
    { "binding": "MODELS_SOURCES", "bucket_name": "fundev-sources-local" }
  ],
  "vars": {
    "TRANSFER_ENABLED": "false",
    "TRANSFER_ORIGIN": "https://fun.dev"
  },
  "dev": {
    "ip": "127.0.0.1",
    "port": 8788,
    "local_protocol": "https"
  },
  "env": {
    "production": {
      "d1_databases": [
        {
          "binding": "DB",
          "database_name": "fundev-progress-production",
          "database_id": "f227dd84-b491-4445-a69c-acc9a989e20a",
          "migrations_dir": "./migrations"
        },
        {
          "binding": "MODELS_DB",
          "database_name": "fundev-models",
          "database_id": "REPLACE_WITH_FUNDEV_MODELS_ID",
          "migrations_dir": "./migrations-models"
        }
      ],
      // The model upload API (docs/models-api.md); its token is the Pages secret MODELS_TOKEN.
      "r2_buckets": [
        { "binding": "MODELS_SOURCES", "bucket_name": "fundev-sources" }
      ],
      "vars": {
        "TRANSFER_ENABLED": "true",
        "TRANSFER_ORIGIN": "https://fun.dev",
        "TRANSFER_API_ORIGIN": "https://api.fun.dev"
      }
    },
    "preview": {
      "d1_databases": [],
      "r2_buckets": [],
      "vars": {
        "TRANSFER_ENABLED": "false",
        "TRANSFER_ORIGIN": "https://fun.dev"
      }
    }
  }
}
