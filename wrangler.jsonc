{
  "$schema": "./node_modules/wrangler/config-schema.json",
  "name": "fundev",
  "pages_build_output_dir": "./dist",
  "compatibility_date": "2026-10-13",
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "fun-dev-progress-local",
      "database_id": "00000000-0000-0000-0000-000000000000",
      "migrations_dir": "./migrations"
    }
  ],
  "vars": {
    "TRANSFER_ENABLED": "false",
    "TRANSFER_ORIGIN": "https://fun.dev"
  },
  "dev": {
    "ip": "127.0.0.1",
    "port": 8788,
    "local_protocol": "https"
  },
  "env": {
    "production": {
      "d1_databases": [
        {
          "binding": "DB",
          "database_name": "fundev-progress-production",
          "database_id": "f227dd84-b491-4445-a69c-acc9a989e20a",
          "migrations_dir": "./migrations"
        }
      ],
      "vars": {
        "TRANSFER_ENABLED": "true",
        "TRANSFER_ORIGIN": "https://fun.dev"
      }
    },
    "preview": {
      "d1_databases": [],
      "vars": {
        "TRANSFER_ENABLED": "false",
        "TRANSFER_ORIGIN": "https://fun.dev"
      }
    }
  }
}
