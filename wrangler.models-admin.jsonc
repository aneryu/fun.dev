{
  // For scripts/models-admin.mjs only (docs/models.md): remote bindings to the production model
  // library, so maintenance runs the console's own functions against the live data. Never deployed.
  "$schema": "./node_modules/wrangler/config-schema.json",
  "name": "fundev-models-admin",
  "compatibility_date": "2026-10-13",
  "d1_databases": [
    {
      "binding": "MODELS_DB",
      "database_name": "fundev-models",
      "database_id": "0db96f73-1f1e-459d-aa41-a8b6772a4e70",
      "remote": true
    }
  ],
  "r2_buckets": [
    { "binding": "MODELS_SOURCES", "bucket_name": "fundev-sources", "remote": true },
    { "binding": "MODELS_PUBLIC", "bucket_name": "fundev-games", "remote": true }
  ]
}
