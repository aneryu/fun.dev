{
  "$schema": "./node_modules/wrangler/config-schema.json",
  "name": "fundev-transfer-cleanup",
  "main": "server/cleanup.js",
  "compatibility_date": "2026-10-13",
  "workers_dev": false,
  "observability": {
    "enabled": true
  },
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "fun-dev-progress-local",
      "database_id": "00000000-0000-0000-0000-000000000000",
      "migrations_dir": "./migrations"
    }
  ],
  "env": {
    "production": {
      "d1_databases": [
        {
          "binding": "DB",
          "database_name": "fundev-progress-production",
          "database_id": "f227dd84-b491-4445-a69c-acc9a989e20a",
          "migrations_dir": "./migrations"
        }
      ],
      "triggers": {
        "crons": [
          "0 * * * *"
        ]
      }
    }
  }
}
